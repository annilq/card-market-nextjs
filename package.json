{
  "name": "koduckya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "payload generate:types && next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "reinit": "node --env-file=.env --import tsx scripts/reinit.ts",
    "indexes": "node --env-file=.env --import tsx scripts/ensure-indexes.ts",
    "bench": "node --env-file=.env --import tsx scripts/bench.ts",
    "check:message": "node --env-file=.env --import tsx scripts/check-action.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/storage-s3": "^3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
