# ---- 必填 ----
DATABASE_URI=postgres://postgres@localhost:5432/card_market_payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# ---- 站点（绝对地址用于 canonical / hreflang / og:image）----
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---- 可选：上传走 S3 兼容对象存储（R2 / AWS S3 / Spaces / MinIO）----
# 全部留空则走本地磁盘 media/（单实例 + 持久卷才可用）
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY=
S3_SECRET=

# ---- 可选：Sentry 错误上报（不填则自动降级为不发送）----
# 客户端 DSN（Sentry Cloud 免费版或自托管 GlitchTip 均可）
NEXT_PUBLIC_SENTRY_DSN=
# 仅构建上传 source map 时需要，本地可留空
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
