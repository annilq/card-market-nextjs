# ---- 必填 ----
DATABASE_URI=postgres://postgres@localhost:5432/card_market_payload
PAYLOAD_SECRET=replace-with-a-long-random-string

# ---- 站点（绝对地址用于 canonical / hreflang / og:image）----
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---- 可选：上传走 S3 兼容对象存储（R2 / AWS S3 / Spaces / MinIO）----
# 全部留空则走本地磁盘 media/（单实例 + 持久卷才可用）
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_KEY=
S3_SECRET=
